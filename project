from flask import Flask, render_template, request
import pickle
import pandas as pd
import shap

app = Flask(__name__)

# Load model files
xgb_model = pickle.load(open("model/xgb_model.pkl", "rb"))
label_encoder = pickle.load(open("model/label_encoder.pkl", "rb"))
symptoms_list = pickle.load(open("model/symptoms.pkl", "rb"))

# SHAP Explainer
shap_explainer = shap.TreeExplainer(xgb_model)



@app.route("/")
def instruction():
    return render_template("instruction.html")


@app.route("/home", methods=["GET", "POST"])
def home():

    if request.method == "POST":

        user_input = request.form.get("symptoms", "").lower()

        if user_input.strip():

            entered_symptoms = [s.strip() for s in user_input.split(",") if s.strip()]

            input_data = {symptom: 0 for symptom in symptoms_list}

            for s in entered_symptoms:
                if s in input_data:
                    input_data[s] = 1

            df_input = pd.DataFrame([input_data])

            # Predict probabilities
            probs = xgb_model.predict_proba(df_input)[0]
            top_idx = probs.argsort()[-3:][::-1]
            max_prob = probs[top_idx[0]]

            results = []

            for i in top_idx:

                disease = label_encoder.inverse_transform([i])[0]
                probability = probs[i]

                relative_conf = (probability / max_prob) * 100
                confidence = round(relative_conf, 2)

                if confidence > 90:
                    risk = "High"
                elif confidence >= 65:
                    risk = "Medium"
                else:
                    risk = "Low"

                results.append({
                    "disease": disease,
                    "confidence": confidence,
                    "risk": risk
                })

            # SHAP Explanation
            shap_values = shap_explainer(df_input)
            main_class = top_idx[0]

            shap_impact = shap_values.values[0, :, main_class]

            shap_df = pd.DataFrame({
                "symptom": symptoms_list,
                "impact": shap_impact
            })

            explanations = (
                shap_df[shap_df["impact"] > 0]
                .sort_values("impact", ascending=False)
                .head(5)["symptom"]
                .tolist()
            )

            return render_template(
                "result.html",
                results=results,
                explanations=explanations,
                model="XGBoost with SHAP Explainable AI"
            )

    return render_template("index.html")



@app.route("/feedback")
def feedback():
    return render_template("feedback.html")


# Other pages
@app.route("/about")
def about():
    return render_template("about.html")


@app.route("/developers")
def developers():
    return render_template("developers.html")


@app.route("/table")
def table():
    return render_template("table.html")


if __name__ == "__main__":
    app.run(debug=True)
