import pandas as pd
import numpy as np
import xgboost as xgb
import matplotlib.pyplot as plt
import pickle
import os
import seaborn as sns

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import LabelEncoder, label_binarize
from sklearn.metrics import (
    accuracy_score,
    confusion_matrix,
    precision_score,
    recall_score,
    f1_score,
    roc_curve,
    auc
)

print("\n====================================")
print("CareSense Disease Prediction Training")
print("====================================\n")
df = pd.read_csv("dataset/Training.csv")
df.columns = df.columns.str.strip().str.lower()

print("Original dataset shape:", df.shape)
df = df.sample(n=8000, random_state=42)
top_diseases = df["diseases"].value_counts().nlargest(50).index
df = df[df["diseases"].isin(top_diseases)]

print("Dataset shape:", df.shape)
X = df.drop("diseases", axis=1)
y = df["diseases"]

label_encoder = LabelEncoder()
y_encoded = label_encoder.fit_transform(y)
xgb_model = xgb.XGBClassifier(
    n_estimators=50,
    max_depth=4,
    learning_rate=0.1,
    subsample=0.8,
    colsample_bytree=0.8,
    objective="multi:softprob",
    eval_metric="mlogloss",
    tree_method="hist",
    n_jobs=4,
    random_state=42
)


X_train, X_test, y_train, y_test = train_test_split(
    X, y_encoded, test_size=0.2, random_state=42, stratify=y_encoded
)
xgb_model.fit(X_train, y_train)
y_pred = xgb_model.predict(X_test)
y_prob = xgb_model.predict_proba(X_test)
accuracy = accuracy_score(y_test, y_pred)
precision_macro = precision_score(y_test, y_pred, average="macro")
recall_macro = recall_score(y_test, y_pred, average="macro")
f1_macro = f1_score(y_test, y_pred, average="macro")

print("\n=========== MODEL PERFORMANCE ===========")
print(f"Accuracy : {accuracy:.3f}")
print(f"Precision: {precision_macro:.3f}")
print(f"Recall   : {recall_macro:.3f}")
print(f"F1 Score : {f1_macro:.3f}")
print("========================================")

cm = confusion_matrix(y_test, y_pred)

plt.figure(figsize=(12,10))
sns.heatmap(
    cm,
    cmap="Blues",
    xticklabels=label_encoder.classes_,
    yticklabels=label_encoder.classes_
)

plt.xlabel("Predicted Disease")
plt.ylabel("Actual Disease")
plt.title("Confusion Matrix (Labeled)")
plt.xticks(rotation=90)
plt.yticks(rotation=0)
plt.tight_layout()
plt.show()
n_classes = len(label_encoder.classes_)
y_test_bin = label_binarize(y_test, classes=range(n_classes))

plt.figure(figsize=(12,10))

for i in range(min(5, n_classes)):
    plt.subplot(2, 3, i+1)

    fpr, tpr, _ = roc_curve(y_test_bin[:, i], y_prob[:, i])
    roc_auc = auc(fpr, tpr)

    plt.plot(fpr, tpr, color='blue', linewidth=2,
             label=f"AUC = {roc_auc:.2f}")

    plt.plot([0,1],[0,1],'k--')

    plt.title(label_encoder.classes_[i])
    plt.xlabel("False Positive Rate")
    plt.ylabel("True Positive Rate")
    plt.legend()
    plt.grid(True)

plt.suptitle("ROC Curves (Each Disease Separately)", fontsize=16)
plt.tight_layout()
plt.show()
os.makedirs("model", exist_ok=True)

pickle.dump(xgb_model, open("model/xgb_model.pkl", "wb"))
pickle.dump(label_encoder, open("model/label_encoder.pkl", "wb"))
pickle.dump(list(X.columns), open("model/symptoms.pkl", "wb"))

print("Model saved!")

importances = xgb_model.feature_importances_

feat_df = pd.DataFrame({
    "feature": X.columns,
    "importance": importances
}).sort_values(by="importance", ascending=False).head(15)

plt.figure(figsize=(10,6))
sns.barplot(x="importance", y="feature", data=feat_df)
plt.title("Top 15 Important Symptoms")
plt.show()

print("\nGenerating Top 15 Disease Graphs...")

top15 = df["diseases"].value_counts().nlargest(15).index
df_top15 = df[df["diseases"].isin(top15)]

X_top15 = df_top15.drop("diseases", axis=1)
y_top15 = df_top15["diseases"]

le_top15 = LabelEncoder()
